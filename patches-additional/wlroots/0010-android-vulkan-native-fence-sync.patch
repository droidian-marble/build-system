+		res = vkCreateFence(bridge->device->dev, &fence_info,
+			NULL, &slot->fence);
+		if (res != VK_SUCCESS) {
+			wlr_vk_error("Android Vulkan bridge: vkCreateFence(async)", res);
+			destroy_async_slots(bridge);
+			return false;
+		}
