+static bool init_async_slots(struct wlr_android_vk_bridge *bridge) {
+	VkCommandBuffer command_buffers[ANDROID_VK_ASYNC_SLOTS] = {0};
+	VkCommandBufferAllocateInfo command_info = {
+		.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+		.commandPool = bridge->command_pool,
+		.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+		.commandBufferCount = ANDROID_VK_ASYNC_SLOTS,
+	};
