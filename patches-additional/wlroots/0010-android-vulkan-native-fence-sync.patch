+static void destroy_async_slots(struct wlr_android_vk_bridge *bridge) {
+	if (bridge == NULL || bridge->device == NULL) {
+		return;
+	}
+	for (size_t i = 0; i < ANDROID_VK_ASYNC_SLOTS; i++) {
+		struct wlr_android_vk_async_slot *slot = &bridge->async_slots[i];
+		if (slot->wait_semaphore != VK_NULL_HANDLE) {
+			vkDestroySemaphore(bridge->device->dev,
+				slot->wait_semaphore, NULL);
+			slot->wait_semaphore = VK_NULL_HANDLE;
+		}
+		if (slot->signal_semaphore != VK_NULL_HANDLE) {
+			vkDestroySemaphore(bridge->device->dev,
+				slot->signal_semaphore, NULL);
+			slot->signal_semaphore = VK_NULL_HANDLE;
+		}
+		if (slot->fence != VK_NULL_HANDLE) {
+			vkDestroyFence(bridge->device->dev, slot->fence, NULL);
+			slot->fence = VK_NULL_HANDLE;
+		}
+	}
+}
