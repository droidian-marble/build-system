+	source_release.dstQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT;
+	VkBufferMemoryBarrier destination_release = destination_acquire;
+	destination_release.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	destination_release.dstAccessMask = 0;
+	destination_release.srcQueueFamilyIndex = bridge->device->queue_family;
+	destination_release.dstQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT;
+	vkCmdPipelineBarrier(command_buffer,
