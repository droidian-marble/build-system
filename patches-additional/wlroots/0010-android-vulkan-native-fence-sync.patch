+		res = vkCreateSemaphore(bridge->device->dev, &wait_info,
+			NULL, &slot->wait_semaphore);
+		if (res != VK_SUCCESS) {
+			wlr_vk_error("Android Vulkan bridge: vkCreateSemaphore(wait)", res);
+			destroy_async_slots(bridge);
+			return false;
+		}
