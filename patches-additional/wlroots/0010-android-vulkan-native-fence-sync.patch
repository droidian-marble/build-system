+		res = vkCreateSemaphore(bridge->device->dev, &signal_info,
+			NULL, &slot->signal_semaphore);
+		if (res != VK_SUCCESS) {
+			wlr_vk_error("Android Vulkan bridge: vkCreateSemaphore(signal)", res);
+			destroy_async_slots(bridge);
+			return false;
+		}
+	}
