+static bool android_extension_supported(const char *extensions,
+		const char *extension) {
+	if (extensions == NULL || extension == NULL || *extension == '\0') {
+		return false;
+	}
+
+	size_t len = strlen(extension);
+	const char *match = extensions;
+	while ((match = strstr(match, extension)) != NULL) {
+		bool start_ok = match == extensions || match[-1] == ' ';
+		bool end_ok = match[len] == '\0' || match[len] == ' ';
+		if (start_ok && end_ok) {
+			return true;
+		}
+		match += len;
+	}
+	return false;
+}
+
+static bool android_wait_and_close_sync_fd(int fd) {
+	if (fd < 0) {
+		return true;
+	}
+
+	struct pollfd pfd = {
+		.fd = fd,
+		.events = POLLIN,
+	};
+	int ret;
+	do {
+		ret = poll(&pfd, 1, -1);
+	} while (ret < 0 && errno == EINTR);
+
+	bool ok = ret > 0 && (pfd.revents & POLLIN) != 0 &&
+		(pfd.revents & (POLLERR | POLLNVAL)) == 0;
+	if (!ok) {
+		if (ret < 0) {
+			wlr_log_errno(WLR_ERROR,
+				"Android native fence: poll(sync_fd) failed");
+		} else {
+			wlr_log(WLR_ERROR,
+				"Android native fence: unexpected sync_fd events 0x%x",
+				(unsigned)pfd.revents);
+		}
+	}
+	close(fd);
+	return ok;
+}
+
+static void android_disable_gpu_native_fence(
+		struct wlr_android_renderer *renderer, const char *reason) {
+	if (renderer->dmabuf_gpu_native_fence_runtime_disabled) {
+		return;
+	}
+	renderer->dmabuf_gpu_native_fence_runtime_disabled = true;
+	if (renderer->dmabuf_stats) {
+		renderer->dmabuf_staging_stats.gpu_native_fence_runtime_disables++;
+	}
+	wlr_log(WLR_ERROR,
+		"Android Vulkan native-fence synchronization disabled: %s; "
+		"using blocking GPU-copy synchronization",
+		reason);
+}
+
+static bool android_gl_finish(struct wlr_android_renderer *renderer) {
+	struct wlr_egl_context prev_ctx;
+	wlr_egl_save_context(&prev_ctx);
+	bool ok = wlr_egl_make_current(renderer->egl);
+	if (ok) {
+		glFinish();
+	}
+	wlr_egl_restore_context(&prev_ctx);
+	return ok;
+}
+
+static bool android_export_gl_native_fence(
+		struct wlr_android_renderer *renderer, int *sync_fd) {
+	*sync_fd = -1;
+	if (renderer->eglCreateSyncKHR == NULL ||
+			renderer->eglDestroySyncKHR == NULL ||
+			renderer->eglDupNativeFenceFDANDROID == NULL) {
+		return false;
+	}
+
+	struct wlr_egl_context prev_ctx;
+	wlr_egl_save_context(&prev_ctx);
+	if (!wlr_egl_make_current(renderer->egl)) {
+		wlr_egl_restore_context(&prev_ctx);
+		return false;
+	}
+
+	const EGLint attribs[] = { EGL_NONE };
+	EGLSyncKHR sync = renderer->eglCreateSyncKHR(renderer->egl->display,
+		EGL_SYNC_NATIVE_FENCE_ANDROID, attribs);
+	if (sync == EGL_NO_SYNC_KHR) {
+		wlr_log(WLR_ERROR,
+			"Android native fence: eglCreateSyncKHR(export) failed: 0x%x",
+			eglGetError());
+		wlr_egl_restore_context(&prev_ctx);
+		return false;
+	}
+
+	// The native fence FD is materialized by the next client API flush.
+	glFlush();
+	int fd = renderer->eglDupNativeFenceFDANDROID(
+		renderer->egl->display, sync);
+	EGLBoolean destroyed = renderer->eglDestroySyncKHR(
+		renderer->egl->display, sync);
+	wlr_egl_restore_context(&prev_ctx);
+
+	if (fd == EGL_NO_NATIVE_FENCE_FD_ANDROID || destroyed != EGL_TRUE) {
+		if (fd >= 0) {
+			close(fd);
+		}
+		wlr_log(WLR_ERROR,
+			"Android native fence: failed to export GLES sync fence");
+		return false;
+	}
+
+	*sync_fd = fd;
+	return true;
+}
+
+static bool android_queue_gl_native_fence_wait(
+		struct wlr_android_renderer *renderer, int sync_fd) {
+	// Vulkan may return -1 for an already-signaled SYNC_FD payload.
+	if (sync_fd < 0) {
+		return true;
+	}
+	if (renderer->eglCreateSyncKHR == NULL ||
+			renderer->eglDestroySyncKHR == NULL ||
+			renderer->eglWaitSyncKHR == NULL) {
+		return android_wait_and_close_sync_fd(sync_fd);
+	}
+
+	int fallback_fd = dup(sync_fd);
+	if (fallback_fd < 0) {
+		wlr_log_errno(WLR_ERROR,
+			"Android native fence: failed to duplicate Vulkan sync_fd");
+		return android_wait_and_close_sync_fd(sync_fd);
+	}
+
+	struct wlr_egl_context prev_ctx;
+	wlr_egl_save_context(&prev_ctx);
+	if (!wlr_egl_make_current(renderer->egl)) {
+		wlr_egl_restore_context(&prev_ctx);
+		close(sync_fd);
+		return android_wait_and_close_sync_fd(fallback_fd);
+	}
+
+	const EGLint attribs[] = {
+		EGL_SYNC_NATIVE_FENCE_FD_ANDROID, sync_fd,
+		EGL_NONE,
+	};
+	EGLSyncKHR sync = renderer->eglCreateSyncKHR(renderer->egl->display,
+		EGL_SYNC_NATIVE_FENCE_ANDROID, attribs);
+	if (sync == EGL_NO_SYNC_KHR) {
+		wlr_log(WLR_ERROR,
+			"Android native fence: eglCreateSyncKHR(import) failed: 0x%x",
+			eglGetError());
+		wlr_egl_restore_context(&prev_ctx);
+		// Ownership transfers only on a successful eglCreateSyncKHR.
+		close(sync_fd);
+		return android_wait_and_close_sync_fd(fallback_fd);
+	}
+
+	EGLint waited = renderer->eglWaitSyncKHR(
+		renderer->egl->display, sync, 0);
+	EGLBoolean destroyed = renderer->eglDestroySyncKHR(
+		renderer->egl->display, sync);
+	wlr_egl_restore_context(&prev_ctx);
+
+	if (waited != EGL_TRUE || destroyed != EGL_TRUE) {
+		wlr_log(WLR_ERROR,
+			"Android native fence: EGL server wait failed");
+		return android_wait_and_close_sync_fd(fallback_fd);
+	}
+
+	close(fallback_fd);
+	return true;
+}
