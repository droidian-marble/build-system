+static struct wlr_android_vk_async_slot *acquire_async_slot(
+		struct wlr_android_vk_bridge *bridge,
+		struct wlr_android_vk_copy_result *result) {
+	for (size_t n = 0; n < ANDROID_VK_ASYNC_SLOTS; n++) {
+		size_t index = (bridge->next_async_slot + n) %
+			ANDROID_VK_ASYNC_SLOTS;
+		struct wlr_android_vk_async_slot *slot =
+			&bridge->async_slots[index];
+
+		if (!slot->in_flight) {
+			bridge->next_async_slot = (index + 1) %
+				ANDROID_VK_ASYNC_SLOTS;
+			return slot;
+		}
+
+		VkResult status = vkGetFenceStatus(bridge->device->dev,
+			slot->fence);
+		if (status == VK_SUCCESS) {
+			VkResult res = vkResetFences(bridge->device->dev,
+				1, &slot->fence);
+			if (res != VK_SUCCESS) {
+				wlr_vk_error("Android Vulkan bridge: vkResetFences", res);
+				return NULL;
+			}
+			slot->in_flight = false;
+			bridge->next_async_slot = (index + 1) %
+				ANDROID_VK_ASYNC_SLOTS;
+			return slot;
+		}
+		if (status != VK_NOT_READY) {
+			wlr_vk_error("Android Vulkan bridge: vkGetFenceStatus", status);
+			return NULL;
+		}
+	}
+
+	struct wlr_android_vk_async_slot *slot =
+		&bridge->async_slots[bridge->next_async_slot];
+	uint64_t wait_start = monotonic_nsec();
+	VkResult res = vkWaitForFences(bridge->device->dev,
+		1, &slot->fence, VK_TRUE, UINT64_MAX);
+	result->slot_wait_ns += monotonic_nsec() - wait_start;
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("Android Vulkan bridge: vkWaitForFences(async slot)", res);
+		return NULL;
+	}
+	res = vkResetFences(bridge->device->dev, 1, &slot->fence);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("Android Vulkan bridge: vkResetFences(async slot)", res);
+		return NULL;
+	}
+	slot->in_flight = false;
+	bridge->next_async_slot =
+		(bridge->next_async_slot + 1) % ANDROID_VK_ASYNC_SLOTS;
+	return slot;
+}
