+static bool dmabuf_wait_for_implicit_fences(int dmabuf_fd, uint32_t flags) {
+	short events = (flags & DMA_BUF_SYNC_WRITE) != 0 ? POLLOUT : POLLIN;
+	struct pollfd pfd = {
+		.fd = dmabuf_fd,
+		.events = events,
+	};
+
+	int ret;
+	do {
+		ret = poll(&pfd, 1, -1);
+	} while (ret < 0 && errno == EINTR);
+
+	if (ret < 0) {
+		wlr_log_errno(WLR_ERROR, "poll(DMA-BUF) failed");
+		return false;
+	}
+	if (ret == 0 || (pfd.revents & events) == 0 ||
+			(pfd.revents & (POLLERR | POLLNVAL)) != 0) {
+		wlr_log(WLR_ERROR,
+			"DMA-BUF poll returned unexpected events: 0x%x",
+			(unsigned int)pfd.revents);
+		return false;
+	}
+
+	return true;
+}
+
+static bool dmabuf_cpu_sync_ioctl(int dmabuf_fd, uint64_t flags) {
+	struct dma_buf_sync sync = {
+		.flags = flags,
+	};
+
+	int ret;
+	do {
+		ret = ioctl(dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync);
+	} while (ret < 0 && (errno == EINTR || errno == EAGAIN));
+
+	if (ret < 0) {
+		wlr_log_errno(WLR_ERROR, "DMA_BUF_IOCTL_SYNC failed");
+		return false;
+	}
+
+	return true;
+}
+
+bool dmabuf_cpu_begin(int dmabuf_fd, uint32_t flags) {
+	if (!dmabuf_wait_for_implicit_fences(dmabuf_fd, flags)) {
+		return false;
+	}
+	return dmabuf_cpu_sync_ioctl(dmabuf_fd,
+		(uint64_t)flags | DMA_BUF_SYNC_START);
+}
+
+bool dmabuf_cpu_end(int dmabuf_fd, uint32_t flags) {
+	return dmabuf_cpu_sync_ioctl(dmabuf_fd,
+		(uint64_t)flags | DMA_BUF_SYNC_END);
+}
