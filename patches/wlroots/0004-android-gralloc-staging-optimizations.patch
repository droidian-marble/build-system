+static void android_staging_release_buffer(
+		struct wlr_android_staging_buffer *staging) {
+	if (staging == NULL) {
+		return;
+	}
+	if (staging->handle != NULL) {
+		hybris_gralloc_release(staging->handle, 1);
+	}
+	free(staging);
+}
+
+static struct wlr_android_staging_buffer *android_staging_pool_take(
+		struct wlr_android_renderer *renderer, int width, int height,
+		int android_format, int usage) {
+	struct wlr_android_staging_buffer *staging;
+	wl_list_for_each(staging, &renderer->dmabuf_staging_pool, pool_link) {
+		if (staging->native_buffer.width != width ||
+				staging->native_buffer.height != height ||
+				staging->android_format != android_format ||
+				staging->usage != usage) {
+			continue;
+		}
+
+		wl_list_remove(&staging->pool_link);
+		renderer->dmabuf_staging_pool_len--;
+		staging->refs = 1;
+		if (renderer->dmabuf_stats) {
+			renderer->dmabuf_staging_stats.pool_hits++;
+		}
+		return staging;
+	}
+
+	if (renderer->dmabuf_stats) {
+		renderer->dmabuf_staging_stats.pool_misses++;
+	}
+	return NULL;
+}
+
+static void android_staging_pool_put(
+		struct wlr_android_staging_buffer *staging) {
+	struct wlr_android_renderer *renderer = staging->renderer;
+	if (renderer->dmabuf_staging_pool_max == 0 ||
+			renderer->dmabuf_staging_pool_len >=
+			renderer->dmabuf_staging_pool_max) {
+		android_staging_release_buffer(staging);
+		return;
+	}
+
+	wl_list_insert(&renderer->dmabuf_staging_pool, &staging->pool_link);
+	renderer->dmabuf_staging_pool_len++;
+}
+
+static void android_staging_pool_finish(
+		struct wlr_android_renderer *renderer) {
+	struct wlr_android_staging_buffer *staging, *tmp;
+	wl_list_for_each_safe(staging, tmp,
+			&renderer->dmabuf_staging_pool, pool_link) {
+		wl_list_remove(&staging->pool_link);
+		android_staging_release_buffer(staging);
+	}
+	renderer->dmabuf_staging_pool_len = 0;
+}
+
+static struct wlr_android_staging_buffer *android_staging_allocate(
+		struct wlr_android_renderer *renderer, int width, int height,
+		int android_format, int usage) {
+	struct wlr_android_staging_buffer *staging =
+		android_staging_pool_take(renderer, width, height,
+			android_format, usage);
+	if (staging != NULL) {
+		return staging;
+	}
+
+	staging = calloc(1, sizeof(*staging));
+	if (staging == NULL) {
+		return NULL;
+	}
+
+	staging->renderer = renderer;
+	staging->android_format = android_format;
+	staging->usage = usage;
+	staging->refs = 1;
+
+	uint32_t stride = 0;
+	int ret = hybris_gralloc_allocate(width, height, android_format,
+		usage, &staging->handle, &stride);
+	if (ret != 0 || staging->handle == NULL) {
+		wlr_log(WLR_DEBUG,
+			"Failed to allocate Android staging format 0x%x: %d",
+			android_format, ret);
+		free(staging);
+		return NULL;
+	}
+
+	staging->stride = stride;
+	staging->native_buffer.common.magic = ANDROID_NATIVE_BUFFER_MAGIC;
+	staging->native_buffer.common.version = sizeof(ANativeWindowBuffer);
+	staging->native_buffer.common.incRef = android_staging_incref;
+	staging->native_buffer.common.decRef = android_staging_decref;
+	memset(staging->native_buffer.common.reserved, 0,
+		sizeof(staging->native_buffer.common.reserved));
+	staging->native_buffer.width = width;
+	staging->native_buffer.height = height;
+	staging->native_buffer.stride = stride;
+	staging->native_buffer.format = android_format;
+	staging->native_buffer.usage = usage;
+	staging->native_buffer.handle = staging->handle;
+
+	return staging;
+}
