+static void android_staging_stats_maybe_log(
+		struct wlr_android_renderer *renderer, uint64_t now_ns) {
+	if (!renderer->dmabuf_stats) {
+		return;
+	}
+
+	if (renderer->dmabuf_staging_stats.window_start_ns == 0) {
+		renderer->dmabuf_staging_stats.window_start_ns = now_ns;
+		return;
+	}
+
+	uint64_t elapsed_ns = now_ns -
+		renderer->dmabuf_staging_stats.window_start_ns;
+	if (elapsed_ns < 1000000000ull) {
+		return;
+	}
+
+	double elapsed_s = (double)elapsed_ns / 1000000000.0;
+	uint64_t updates = renderer->dmabuf_staging_stats.updates;
+	double copy_mib_s = elapsed_s > 0.0 ?
+		(double)renderer->dmabuf_staging_stats.copied_bytes /
+		(1024.0 * 1024.0 * elapsed_s) : 0.0;
+	double lock_ms = updates > 0 ?
+		(double)renderer->dmabuf_staging_stats.lock_ns /
+		(double)updates / 1000000.0 : 0.0;
+	double copy_ms = updates > 0 ?
+		(double)renderer->dmabuf_staging_stats.copy_ns /
+		(double)updates / 1000000.0 : 0.0;
+	double unlock_ms = updates > 0 ?
+		(double)renderer->dmabuf_staging_stats.unlock_ns /
+		(double)updates / 1000000.0 : 0.0;
+
+	wlr_log(WLR_INFO,
+		"Android dmabuf staging stats: updates=%" PRIu64
+		" full=%" PRIu64 " damage=%" PRIu64 " coalesced=%" PRIu64
+		" direct=%" PRIu64 " neon=%" PRIu64 " scalar=%" PRIu64
+		" copy=%.1f MiB/s lock=%.3fms copy_cpu=%.3fms unlock=%.3fms"
+		" pool=%" PRIu64 "/%" PRIu64 " bgra_fallback=%" PRIu64
+		" generic_fallback=%" PRIu64 " failures=%" PRIu64,
+		updates,
+		renderer->dmabuf_staging_stats.full_copies,
+		renderer->dmabuf_staging_stats.damage_updates,
+		renderer->dmabuf_staging_stats.coalesced_updates,
+		renderer->dmabuf_staging_stats.direct_updates,
+		renderer->dmabuf_staging_stats.neon_updates,
+		renderer->dmabuf_staging_stats.scalar_updates,
+		copy_mib_s, lock_ms, copy_ms, unlock_ms,
+		renderer->dmabuf_staging_stats.pool_hits,
+		renderer->dmabuf_staging_stats.pool_misses,
+		renderer->dmabuf_staging_stats.bgra_fallbacks,
+		renderer->dmabuf_staging_stats.generic_fallbacks,
+		renderer->dmabuf_staging_stats.failures);
+
+	memset(&renderer->dmabuf_staging_stats, 0,
+		sizeof(renderer->dmabuf_staging_stats));
+	renderer->dmabuf_staging_stats.window_start_ns = now_ns;
+}
