+static struct wlr_texture *android_texture_from_dmabuf_staging(
+		struct wlr_renderer *wlr_renderer, struct wlr_buffer *buffer,
+		const struct wlr_dmabuf_attributes *dmabuf) {
+	if (dmabuf->n_planes != 1 ||
+			(dmabuf->format != DRM_FORMAT_ARGB8888 &&
+			dmabuf->format != DRM_FORMAT_XRGB8888) ||
+			(dmabuf->modifier != DRM_FORMAT_MOD_LINEAR &&
+			dmabuf->modifier != DRM_FORMAT_MOD_INVALID)) {
+		return NULL;
+	}
+
+	struct wlr_android_renderer *renderer = android_get_renderer(wlr_renderer);
+	struct wlr_gles2_renderer *gles2 = android_get_gles2_renderer(wlr_renderer);
+	if (gles2->procs.glEGLImageTargetTexture2DOES == NULL ||
+			gles2->egl->procs.eglCreateImageKHR == NULL) {
+		return NULL;
+	}
+
+	if (renderer->dmabuf_staging_bgra) {
+		struct wlr_texture *texture =
+			android_texture_from_dmabuf_staging_format(wlr_renderer,
+				buffer, dmabuf, HAL_PIXEL_FORMAT_BGRA_8888);
+		if (texture != NULL) {
+			return texture;
+		}
+		if (renderer->dmabuf_stats) {
+			renderer->dmabuf_staging_stats.bgra_fallbacks++;
+		}
+	}
+
+	return android_texture_from_dmabuf_staging_format(wlr_renderer,
+		buffer, dmabuf, HAL_PIXEL_FORMAT_RGBA_8888);
+}
