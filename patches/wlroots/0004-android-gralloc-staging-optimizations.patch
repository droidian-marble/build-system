+static bool android_swizzle_bgra_to_rgba(uint8_t *dst, const uint8_t *src,
+		size_t pixels, bool force_opaque, bool enable_neon) {
+	bool used_neon = false;
+
+#if defined(__aarch64__) || defined(__ARM_NEON)
+	if (enable_neon) {
+		const uint8x16_t opaque = vdupq_n_u8(0xff);
+		while (pixels >= 16) {
+			uint8x16x4_t in = vld4q_u8(src);
+			uint8x16x4_t out;
+			out.val[0] = in.val[2];
+			out.val[1] = in.val[1];
+			out.val[2] = in.val[0];
+			out.val[3] = force_opaque ? opaque : in.val[3];
+			vst4q_u8(dst, out);
+			src += 16 * 4;
+			dst += 16 * 4;
+			pixels -= 16;
+			used_neon = true;
+		}
+	}
+#else
+	(void)enable_neon;
+#endif
+
+	while (pixels-- > 0) {
+		dst[0] = src[2];
+		dst[1] = src[1];
+		dst[2] = src[0];
+		dst[3] = force_opaque ? 0xff : src[3];
+		src += 4;
+		dst += 4;
+	}
+
+	return used_neon;
+}
