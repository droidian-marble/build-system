+bool wlr_android_vk_bridge_wait_idle(struct wlr_android_vk_bridge *bridge) {
+	if (bridge == NULL || bridge->device == NULL) {
+		return false;
+	}
+
+	VkResult res = vkQueueWaitIdle(bridge->device->queue);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("Android Vulkan bridge: vkQueueWaitIdle(recovery)", res);
+		return false;
+	}
+
+	for (size_t i = 0; i < ANDROID_VK_ASYNC_SLOTS; i++) {
+		struct wlr_android_vk_async_slot *slot = &bridge->async_slots[i];
+		if (!slot->in_flight) {
+			continue;
+		}
+		res = vkResetFences(bridge->device->dev, 1, &slot->fence);
+		if (res != VK_SUCCESS) {
+			wlr_vk_error(
+				"Android Vulkan bridge: vkResetFences(queue-idle recovery)",
+				res);
+			bridge->sync_fd_supported = false;
+		}
+		slot->in_flight = false;
+	}
+	return true;
+}
