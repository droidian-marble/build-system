+static bool recover_async_queue_idle(
+		struct wlr_android_vk_bridge *bridge,
+		struct wlr_android_vk_copy_result *result, const char *reason) {
+	bridge->sync_fd_supported = false;
+	VkResult res = vkQueueWaitIdle(bridge->device->queue);
+	if (res != VK_SUCCESS) {
+		wlr_log(WLR_ERROR, "%s: %s (%d)",
+			reason, vulkan_strerror(res), res);
+		result->completion_unknown = true;
+		return false;
+	}
+
+	for (size_t i = 0; i < ANDROID_VK_ASYNC_SLOTS; i++) {
+		bridge->async_slots[i].in_flight = false;
+	}
+	return true;
+}
+
+static bool wait_slot_completion(struct wlr_android_vk_bridge *bridge,
+		struct wlr_android_vk_async_slot *slot,
+		struct wlr_android_vk_copy_result *result, const char *reason) {
+	uint64_t wait_start = monotonic_nsec();
+	VkResult res = vkWaitForFences(bridge->device->dev,
+		1, &slot->fence, VK_TRUE, UINT64_MAX);
+	result->slot_wait_ns += monotonic_nsec() - wait_start;
+	if (res == VK_SUCCESS) {
+		res = vkResetFences(bridge->device->dev, 1, &slot->fence);
+		if (res != VK_SUCCESS) {
+			wlr_vk_error(
+				"Android Vulkan bridge: vkResetFences(completion recovery)",
+				res);
+			bridge->sync_fd_supported = false;
+		}
+		slot->in_flight = false;
+		return true;
+	}
+
+	wlr_log(WLR_ERROR, "%s: %s (%d)",
+		reason, vulkan_strerror(res), res);
+	return recover_async_queue_idle(bridge, result,
+		"Android Vulkan bridge: vkQueueWaitIdle(completion recovery)");
+}
