+static bool buffer_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct wlr_dmabuf_v1_buffer *buffer =
+		dmabuf_v1_buffer_from_buffer(wlr_buffer);
+	struct wlr_dmabuf_attributes *attribs = &buffer->attributes;
+
+	if (!(flags & WLR_BUFFER_DATA_PTR_ACCESS_READ) ||
+			(flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE)) {
+		return false;
+	}
+
+	if (attribs->n_planes != 1) {
+		wlr_log(WLR_DEBUG,
+			"Android DMA-BUF CPU fallback only supports single-plane buffers");
+		return false;
+	}
+
+	if (attribs->format != DRM_FORMAT_ARGB8888 &&
+			attribs->format != DRM_FORMAT_XRGB8888) {
+		wlr_log(WLR_DEBUG,
+			"Android DMA-BUF CPU fallback rejected format 0x%"PRIX32,
+			attribs->format);
+		return false;
+	}
+
+	if (attribs->modifier != DRM_FORMAT_MOD_LINEAR &&
+			attribs->modifier != DRM_FORMAT_MOD_INVALID) {
+		wlr_log(WLR_DEBUG,
+			"Android DMA-BUF CPU fallback rejected non-linear modifier");
+		return false;
+	}
+
+	uint64_t map_size =
+		(uint64_t)attribs->offset[0] +
+		(uint64_t)attribs->stride[0] * (uint64_t)wlr_buffer->height;
+
+	if (map_size == 0 || map_size > SIZE_MAX) {
+		return false;
+	}
+
+	if (buffer->mapped_data == NULL) {
+		buffer->mapped_data = mmap(NULL, (size_t)map_size, PROT_READ,
+			MAP_SHARED, attribs->fd[0], 0);
+		if (buffer->mapped_data == MAP_FAILED) {
+			buffer->mapped_data = NULL;
+			wlr_log_errno(WLR_ERROR,
+				"Failed to mmap Android linux-dmabuf buffer");
+			return false;
+		}
+		buffer->mapped_size = (size_t)map_size;
+
+		wlr_log(WLR_INFO,
+			"Mapped Android linux-dmabuf buffer: %dx%d stride=%u format=0x%"PRIX32,
+			wlr_buffer->width, wlr_buffer->height,
+			attribs->stride[0], attribs->format);
+	}
+
+	struct dma_buf_sync sync = {
+		.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ,
+	};
+
+	if (ioctl(attribs->fd[0], DMA_BUF_IOCTL_SYNC, &sync) == 0) {
+		buffer->data_access_active = true;
+	} else if (errno != ENOTTY && errno != EINVAL && errno != ENOSYS) {
+		wlr_log_errno(WLR_ERROR,
+			"DMA_BUF_IOCTL_SYNC START failed");
+		return false;
+	}
+
+	*data = (uint8_t *)buffer->mapped_data + attribs->offset[0];
+	*format = attribs->format;
+	*stride = attribs->stride[0];
+	return true;
+}
+
+static void buffer_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+	struct wlr_dmabuf_v1_buffer *buffer =
+		dmabuf_v1_buffer_from_buffer(wlr_buffer);
+
+	if (!buffer->data_access_active) {
+		return;
+	}
+
+	struct dma_buf_sync sync = {
+		.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ,
+	};
+
+	if (ioctl(buffer->attributes.fd[0], DMA_BUF_IOCTL_SYNC, &sync) != 0 &&
+			errno != ENOTTY && errno != EINVAL && errno != ENOSYS) {
+		wlr_log_errno(WLR_ERROR,
+			"DMA_BUF_IOCTL_SYNC END failed");
+	}
+
+	buffer->data_access_active = false;
+}
