+static void android_staging_pool_evict_lru(
+		struct wlr_android_renderer *renderer) {
+	if (wl_list_empty(&renderer->dmabuf_staging_pool)) {
+		return;
+	}
+
+	struct wlr_android_staging_buffer *staging = wl_container_of(
+		renderer->dmabuf_staging_pool.prev, staging, pool_link);
+	android_staging_pool_remove(renderer, staging);
+	if (renderer->dmabuf_stats) {
+		renderer->dmabuf_staging_stats.pool_evictions++;
+	}
+	android_staging_release_buffer(staging);
+}
+
 static void android_staging_pool_put(
 		struct wlr_android_staging_buffer *staging) {
 	struct wlr_android_renderer *renderer = staging->renderer;
 	if (renderer->dmabuf_staging_pool_max == 0 ||
-			renderer->dmabuf_staging_pool_len >=
-			renderer->dmabuf_staging_pool_max) {
+			renderer->dmabuf_staging_pool_bytes_max == 0 ||
+			staging->allocation_bytes >
+			renderer->dmabuf_staging_pool_bytes_max) {
+		if (renderer->dmabuf_stats) {
+			renderer->dmabuf_staging_stats.pool_oversize_drops++;
+		}
 		android_staging_release_buffer(staging);
 		return;
 	}
 
+	while (renderer->dmabuf_staging_pool_len >=
+			renderer->dmabuf_staging_pool_max ||
+			renderer->dmabuf_staging_pool_bytes >
+				renderer->dmabuf_staging_pool_bytes_max -
+				staging->allocation_bytes) {
+		android_staging_pool_evict_lru(renderer);
+	}
+
 	wl_list_insert(&renderer->dmabuf_staging_pool, &staging->pool_link);
 	renderer->dmabuf_staging_pool_len++;
+	renderer->dmabuf_staging_pool_bytes += staging->allocation_bytes;
 }
 
