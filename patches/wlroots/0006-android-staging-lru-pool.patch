+static void android_staging_pool_remove(
+		struct wlr_android_renderer *renderer,
+		struct wlr_android_staging_buffer *staging) {
+	wl_list_remove(&staging->pool_link);
+	assert(renderer->dmabuf_staging_pool_len > 0);
+	assert(renderer->dmabuf_staging_pool_bytes >= staging->allocation_bytes);
+	renderer->dmabuf_staging_pool_len--;
+	renderer->dmabuf_staging_pool_bytes -= staging->allocation_bytes;
+}
