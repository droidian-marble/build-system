     }
     return ret;
 }
+
+int MtpRequestPacket::read(IMtpHandle* handle) {
+    int ret = handle->read(mBuffer, mBufferSize);
+    if (ret < 0)
+        return ret;
+    if (ret >= MTP_CONTAINER_HEADER_SIZE && ret <= MTP_CONTAINER_HEADER_SIZE + 5 * sizeof(uint32_t) && ((ret - MTP_CONTAINER_HEADER_SIZE) & 3) == 0) {
+        mPacketSize = ret;
+        mParameterCount = (ret - MTP_CONTAINER_HEADER_SIZE) / sizeof(uint32_t);
+    } else {
+        LOG(ERROR) << "Malformed MTP request packet";
+        ret = -1;
+    }
+    return ret;
+}
 #endif
 
