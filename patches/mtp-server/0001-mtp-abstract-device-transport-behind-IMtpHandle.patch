+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "IMtpHandle.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <string>
+
+namespace android {
+
+class MtpDevHandle : public IMtpHandle {
+public:
+    explicit MtpDevHandle(const char* path) : mPath(path), mFd(-1) {}
+    explicit MtpDevHandle(int fd) : mFd(fd) {}
+    ~MtpDevHandle() override { close(); }
+
+    int configure(bool) override { return 0; }
+    int start(bool) override {
+        if (mFd >= 0)
+            return 0;
+        mFd = ::open(mPath.c_str(), O_RDWR);
+        return mFd < 0 ? -1 : 0;
+    }
+    int read(void* data, size_t len) override { return ::read(mFd, data, len); }
+    int write(const void* data, size_t len) override { return ::write(mFd, data, len); }
+    int receiveFile(const mtp_file_range& mfr, bool) override { return ::ioctl(mFd, MTP_RECEIVE_FILE, &mfr); }
+    int sendFile(const mtp_file_range& mfr) override { return ::ioctl(mFd, MTP_SEND_FILE_WITH_HEADER, &mfr); }
+    int sendEvent(const mtp_event& event) override { return ::ioctl(mFd, MTP_SEND_EVENT, &event); }
+    void close() override {
+        if (mFd >= 0) {
+            ::close(mFd);
+            mFd = -1;
+        }
+    }
+
+private:
+    std::string mPath;
+    int mFd;
+};
+
+IMtpHandle* createMtpDevHandle(const char* path) { return new MtpDevHandle(path); }
+IMtpHandle* createMtpDevHandleFromFd(int fd) { return new MtpDevHandle(fd); }
+
+} // namespace android
