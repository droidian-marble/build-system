+namespace {
+
+struct MtpTransportState {
+    IMtpHandle* handle;
+    bool owned;
+};
+
+std::mutex gTransportMutex;
+std::map<const MtpServer*, MtpTransportState> gTransports;
+
+void setMtpHandle(const MtpServer* server, IMtpHandle* handle, bool owned) {
+    std::lock_guard<std::mutex> lock(gTransportMutex);
+    gTransports[server] = {handle, owned};
+}
+
+IMtpHandle* mtpHandle(const MtpServer* server) {
+    std::lock_guard<std::mutex> lock(gTransportMutex);
+    std::map<const MtpServer*, MtpTransportState>::const_iterator it = gTransports.find(server);
+    return it == gTransports.end() ? NULL : it->second.handle;
+}
+
+void clearMtpHandle(const MtpServer* server) {
+    IMtpHandle* handle = NULL;
+    bool owned = false;
+    {
+        std::lock_guard<std::mutex> lock(gTransportMutex);
+        std::map<const MtpServer*, MtpTransportState>::iterator it = gTransports.find(server);
+        if (it == gTransports.end())
+            return;
+        handle = it->second.handle;
+        owned = it->second.owned;
+        gTransports.erase(it);
+    }
+    if (owned)
+        delete handle;
+}
+
+} // namespace
