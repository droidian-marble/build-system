From 65bd715ab30308bc30d7cf94a2fbb25add890246 Mon Sep 17 00:00:00 2001
From: Halhadus <eneshakans45@proton.me>
Date: Mon, 14 Sep 2026 20:41:55 +0300
Subject: [PATCH] [scripts] halium: add hook for loading extra kernel modules

---
 scripts/halium | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/scripts/halium b/scripts/halium
index 01c0951..a6fc990 100644
--- a/scripts/halium
+++ b/scripts/halium
@@ -748,6 +748,8 @@ mountroot() {
 
 	mount_vendor_partitions "$ab_slot_suffix"
 
+	halium_hook load_extra_kernel_modules
+
 	# Check if we should prefer LVM mounts. If that's the case, try
 	# mounting the droidian-rootfs LV first, then fallback to the standard
 	# halium way (where we assume that userdata is a mountable partition)
