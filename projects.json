{
  "defaults": {
    "architecture": "arm64",
    "images": {
      "arm64": "quay.io/droidian/build-essential:next-arm64",
      "amd64": "quay.io/droidian/build-essential:current-amd64"
    },
    "runners": {
      "arm64": "ubuntu-24.04-arm",
      "amd64": "ubuntu-latest"
    },
    "build_command": "releng-build-package",
    "deb_build_options": "nocheck",
    "deb_fullname": "Halhadus",
    "deb_email": "eneshakans45@proton.me",
    "apt_packages": [
      "devscripts",
      "equivs",
      "dpkg-dev"
    ]
  },
  "projects": [
    {
      "name": "libhybris",
      "enabled": true,
      "repo": "https://github.com/droidian/libhybris.git",
      "branch": "feature/next/lindroid-drm",
      "apt_packages": [
        "android-headers-30"
      ],
      "dependencies": []
    },
    {
      "name": "wlroots",
      "enabled": true,
      "repo": "https://github.com/droidian/wlroots.git",
      "branch": "feature/next/backport-0.18",
      "apt_packages": [
        "android-headers-30",
        "python3"
      ],
      "dependencies": [
        {
          "project": "libhybris",
          "packages": [
            "libandroid-properties1",
            "libandroid-properties-dev",
            "libhardware2",
            "libhardware-dev",
            "libhybris-common1",
            "libhybris-common-dev",
            "libhybris",
            "libhybris-dev",
            "libmedia1",
            "libmedia-dev"
          ]
        }
      ]
    },
    {
      "name": "linux-droidian-marble-gki",
      "enabled": true,
      "repo": "https://github.com/droidian-marble/linux-droidian-marble-gki.git",
      "branch": "droidian",
      "architecture": "amd64",
      "apt_packages": [
        "curl",
        "aria2",
        "git",
        "fakeroot",
        "build-essential",
        "ncurses-dev",
        "xz-utils",
        "libssl-dev",
        "bc",
        "flex",
        "libelf-dev",
        "bison",
        "findutils",
        "android-platform-prebuilts-python-linux-x86-2.7.5",
        "rsync",
        "kmod",
        "cpio",
        "avbtool",
        "binutils-aarch64-linux-gnu",
        "gcc-4.9-aarch64-linux-android",
        "g++-4.9-aarch64-linux-android",
        "libgcc-4.9-dev-aarch64-linux-android-cross",
        "lz4",
        "linux-packaging-snippets",
        "clang-android-12.0-r416183b"
      ],
      "build_command": "export PATH=\"/opt/android/prebuilts/python/2.7.5/bin:$PATH\"; debuild --no-lintian -F -d -sa --no-sign --jobs=\"$(nproc)\" -aarm64",
      "dependencies": []
    }
  ]
}
